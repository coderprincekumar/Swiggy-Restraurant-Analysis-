        "import pandas as pd\n",
        "import duckdb\n",
        "\n",
        "# Load dataset\n",
        "df = pd.read_csv('/content/extracted_files/swiggy_file.csv')\n",
        "\n",
        "# Standardise columns for the SQL query\n",
        "swiggy = df.rename(columns={\n",
        "    'Restaurant Name': 'restaurant_name',\n",
        "    'Location': 'city'\n",
        "})\n",
        "\n",
        "# SQL Query to find restaurants listed per city\n",
        "query = \"\"\"\n",
        "SELECT city, COUNT(*) AS total_restaurants\n",
        "FROM swiggy\n",
        "GROUP BY city\n",
        "ORDER BY total_restaurants DESC;\n",
        "\"\"\"\n",
        "\n",
        "# Execute query and display results\n",
        "result_df = duckdb.query(query).to_df()\n",
        "display(result_df)"
