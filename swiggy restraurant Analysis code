        "\n",
        "\n",
        "# Map pandas column names to match the SQL query expectations\n",
        "# (SQL names are lowercase with underscores)\n",
        "swiggy = df.rename(columns={\n",
        "    'Restaurant Name': 'restaurant_name',\n",
        "    'Rating': 'rating',\n",
        "    'Location': 'city'\n",
        "})\n",
        "\n",
        "# Run the check queries using DuckDB\n",
        "print(\"--- Total Records ---\")\n",
        "display(duckdb.query(\"SELECT COUNT(*) FROM swiggy;\").to_df())\n",
        "\n",
        "print(\"\\n--- Nulls in Key Columns ---\")\n",
        "null_query = \"\"\"\n",
        "SELECT\n",
        "  SUM(CASE WHEN restaurant_name IS NULL THEN 1 ELSE 0 END) AS null_names,\n",
        "  SUM(CASE WHEN rating IS NULL THEN 1 ELSE 0 END) AS null_ratings,\n",
        "  SUM(CASE WHEN city IS NULL THEN 1 ELSE 0 END) AS null_cities\n",
        "FROM swiggy;\n",
        "\"\"\"\n",
        "display(duckdb.query(null_query).to_df())\n",
        "\n",
        "# Filter out ratings in pandas instead of inplace DELETE/UPDATE SQL syntax\n",
        "# to keep it simple and clean within the DataFrame\n",
        "print(\"\\n--- Standardising Ratings ---\")\n",
        "# Remove rows where rating is 'NEW' or '--'\n",
        "swiggy_clean = swiggy[~swiggy['rating'].isin(['NEW', '--'])].copy()\n",
        "\n",
        "# Convert rating to numeric (equivalent to CAST)\n",
        "swiggy_clean['rating'] = pd.to_numeric(swiggy_clean['rating'], errors='coerce')\n",
        "\n",
        "print(\"Ratings cleaned and cast to numeric:\")\n",
        "display(swiggy_clean[['restaurant_name', 'rating', 'city']].head())"
