      "source": [
        "# 1. Clean rating and handle 'K' multiplier in 'Number of Ratings' (e.g., 1K+ -> 1000, 5K+ -> 5000)\n",
        "def parse_ratings_count(val):\n",
        "    if pd.isna(val):\n",
        "        return 0.0\n",
        "    val_str = str(val).upper().replace('+', '').replace('RATINGS', '').strip()\n",
        "    if 'K' in val_str:\n",
        "        try:\n",
        "            return float(val_str.replace('K', '').strip()) * 1000\n",
        "        except:\n",
        "            return 0.0\n",
        "    try:\n",
        "        return float(val_str)\n",
        "    except:\n",
        "        return 0.0\n",
        "\n",
        "df['Rating_Cleaned'] = pd.to_numeric(df['Rating'], errors='coerce')\n",
        "df['Rating_Count_Cleaned'] = df['Number of Ratings'].apply(parse_ratings_count)\n",
        "\n",
        "# 2. Filter for ratings > 4.5 and review counts > 1000\n",
        "highly_rated_and_popular = df[\n",
        "    (df['Rating_Cleaned'] > 4.5) &\n",
        "    (df['Rating_Count_Cleaned'] > 1000)\n",
        "]\n",
        "\n",
        "# Display the matching restaurants\n",
        "display(highly_rated_and_popular[['Restaurant Name', 'Location', 'Rating', 'Number of Ratings', 'Average Price']])"
      ],
